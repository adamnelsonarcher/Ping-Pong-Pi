# Copy to .env.local and fill in. NEVER commit the filled-in file.
#
# In production these are set as Vercel project environment variables
# (Project → Settings → Environment Variables), not from a file.

# ---------------------------------------------------------------------------
# Server-side only. The private key is a full-access admin credential for the
# Firebase project — it bypasses all security rules. Treat it like a root
# password. Anything prefixed REACT_APP_ is compiled into the public bundle,
# so these three MUST NOT be, and are not.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the surrounding double quotes: dotenv expands the \n escapes inside them.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Client-side. These are compiled into the JavaScript bundle and are visible to
# anyone who opens devtools — that is expected and fine. A Firebase web API key
# is an identifier, not a secret; access is controlled by Firebase security
# rules and by the authorised-domains list in the Firebase console.
# ---------------------------------------------------------------------------
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. Leave unset to allow
# only same-origin requests (correct for the Vercel deployment, where the API
# and the app share an origin).
# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS=http://localhost:3000
